NODE_ENV=development
DATABASE_PATH=./data/app.sqlite
DATA_DIR=./data

OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
OPENAI_IMAGE_MODEL=

CHROME_CHANNEL=chrome
CHROME_EXECUTABLE_PATH=
CHROME_PROFILE_PATH=
HEADLESS=false

APP_TIMEZONE=Asia/Tokyo
AUTHORIZED_TEST_BLOG_ID=
AUTHORIZED_BLOG_IDS=

ENABLE_AUTO_TOPIC_SELECTION=false
ENABLE_ARTICLE_GENERATION=true
ENABLE_IMAGE_GENERATION=true
ENABLE_DRY_RUN=true
ENABLE_DRAFT_SAVE=false
ENABLE_SCHEDULED_POST=false

SYSTEM_DAILY_POST_LIMIT=3
PER_BLOG_DAILY_POST_LIMIT=1
MAX_CONSECUTIVE_FAILURES=3

MIN_LONG_TERM_VALUE_SCORE=65
MIN_JAPANESE_CONTENT_GAP_SCORE=70
MIN_JAPAN_RELEVANCE_SCORE=50
MIN_OPPORTUNITY_SCORE=70
MIN_CONFIDENCE=0.65

LOG_LEVEL=info


